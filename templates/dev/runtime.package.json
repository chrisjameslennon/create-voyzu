{
  "name": "{{PROJECT_NAME}}-development-runtime",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "voyzu/apps/*",
    "voyzu/lib/*",
    "voyzu/packages/*",
    "voyzu/packages/@voyzu/*",
    "packages/*",
    "packages/@*/*"
  ],
  "scripts": {
    "dev": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:dev",
    "build": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run build",
    "start": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run start",
    "voyzu:add-repo": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:add-repo --",
    "voyzu:install": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:install --",
    "voyzu:update": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:update",
    "voyzu:update-repos": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:update-repos",
    "voyzu:update-repo": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:update-repo --",
    "voyzu:initialize": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:initialize",
    "voyzu:install-package": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:install-package --",
    "voyzu:uninstall-package": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:uninstall-package --",
    "voyzu:list-packages": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:list-packages",
    "voyzu:create-package": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:create-package --",
    "voyzu:link-package": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:link-package --",
    "voyzu:link-packages": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:link-packages",
    "voyzu:compose": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:compose",
    "voyzu:build-api-reference": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:build-api-reference",
    "voyzu:run-script": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:run-script --"
  }
}

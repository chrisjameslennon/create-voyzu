{
  "name": "{{PROJECT_NAME}}-development-runtime",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "voyzu/apps/*",
    "voyzu/packages/*",
    "voyzu/packages/@voyzu/*",
    "packages/*",
    "packages/@*/*"
  ],
  "scripts": {
    "dev": "npm --prefix voyzu run dev",
    "build": "npm --prefix voyzu run build",
    "start": "npm --prefix voyzu run start",
    "voyzu:add-repo": "npm --prefix voyzu run voyzu:add-repo --",
    "voyzu:install": "npm --prefix voyzu run voyzu:install --",
    "voyzu:refresh": "npm --prefix voyzu run voyzu:refresh",
    "voyzu:refresh-repos": "npm --prefix voyzu run voyzu:refresh-repos",
    "voyzu:refresh-repo": "npm --prefix voyzu run voyzu:refresh-repo --",
    "voyzu:initialize": "npm --prefix voyzu run voyzu:initialize",
    "voyzu:install-package": "npm --prefix voyzu run voyzu:install-package --",
    "voyzu:list-packages": "npm --prefix voyzu run voyzu:list-packages",
    "voyzu:link-package": "npm --prefix voyzu run voyzu:link-package --",
    "voyzu:link-packages": "npm --prefix voyzu run voyzu:link-packages",
    "voyzu:compose": "npm --prefix voyzu run voyzu:compose",
    "voyzu:run-script": "npm --prefix voyzu run voyzu:run-script --"
  },
  "voyzu": {
    "mode": "development",
    "platform": {
      "repository": "{{VOYZU_REPOSITORY}}",
      "ref": "{{VOYZU_REF}}",
      "directory": "voyzu"
    }
  }
}

{
  "name": "{{PROJECT_NAME}}",
  "description": "Voyzu package development",
  "scripts": {
    "voyzu:initialize": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:initialize",
    "voyzu:install": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:install --",
    "voyzu:start": "node .run/voyzu/lib/runtime-tools/run-npm.mjs run start",
    "voyzu:update": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:update",
    "voyzu:add-repo": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:add-repo --",
    "voyzu:update-repos": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:update-repos",
    "voyzu:update-repo": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:update-repo --",
    "voyzu:install-package": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:install-package --",
    "voyzu:uninstall-package": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:uninstall-package --",
    "voyzu:list-packages": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:list-packages",
    "voyzu:compose": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:compose",
    "voyzu:create-package": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:create-package --",
    "voyzu:build-api-reference": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:build-api-reference",
    "voyzu:run-script": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:run-script --",
    "voyzu:build": "node .run/voyzu/lib/runtime-tools/run-npm.mjs run build",
    "voyzu:dev": "node .run/voyzu/lib/runtime-tools/run-npm.mjs run dev",
    "voyzu:link-package": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:link-package --",
    "voyzu:link-packages": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run voyzu:link-packages",
    "dev": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run dev",
    "build": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run build",
    "prestart": "node .run/voyzu/lib/runtime-tools/run-npm.mjs run build",
    "start": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run run start"
  },
  "voyzu": {
    "mode": "development",
    "platform": {
      "repository": "{{VOYZU_REPOSITORY}}",
      "branch": "main"
    }
  }
}

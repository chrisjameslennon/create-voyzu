{
  "name": "{{PROJECT_NAME}}-development-runtime",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "voyzu/apps/*",
    "voyzu/packages/*",
    "voyzu/packages/@voyzu/*",
    "voyzu-packages/*",
    "voyzu-packages/@*/*"
  ],
  "scripts": {
    "dev": "npm --prefix voyzu run dev",
    "build": "npm --prefix voyzu run build",
    "typecheck": "npm --prefix voyzu run typecheck",
    "compose": "voyzu compose",
    "voyzu": "voyzu"
  },
  "voyzu": {
    "mode": "development",
    "composedPackages": [],
    "platform": {
      "repository": "{{VOYZU_REPOSITORY}}",
      "ref": "{{VOYZU_REF}}",
      "directory": "voyzu"
    },
    "packageSource": {
      "directory": ".."
    }
  }
}

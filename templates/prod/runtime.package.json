{
  "name": "{{PROJECT_NAME}}-runtime",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "voyzu/apps/*",
    "voyzu/lib/*",
    "voyzu/packages/*",
    "voyzu/packages/@voyzu/*",
    "packages/*",
    "packages/@*/*"
  ],
  "scripts": {
    "dev": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run dev",
    "build": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run build",
    "start": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run start",
    "voyzu:build-api-reference": "node voyzu/lib/runtime-tools/run-npm.mjs --prefix voyzu run voyzu:build-api-reference"
  }
}

{
  "name": "{{PROJECT_NAME}}",
  "description": "Voyzu runtime installation",
  "scripts": {
    "voyzu:dev": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run dev",
    "voyzu:build": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run build",
    "prestart": "node .run/voyzu/lib/runtime-tools/run-npm.mjs run voyzu:build",
    "start": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run start",
    "voyzu:start": "node .run/voyzu/lib/runtime-tools/run-npm.mjs run start",
    "voyzu:add-repo": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run voyzu:add-repo --",
    "voyzu:install": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run voyzu:install --",
    "voyzu:update": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run voyzu:update",
    "voyzu:update-repos": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run voyzu:update-repos",
    "voyzu:update-repo": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run voyzu:update-repo --",
    "voyzu:initialize": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run voyzu:initialize",
    "voyzu:install-package": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run voyzu:install-package --",
    "voyzu:uninstall-package": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run voyzu:uninstall-package --",
    "voyzu:list-packages": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run voyzu:list-packages",
    "voyzu:compose": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run voyzu:compose",
    "voyzu:build-api-reference": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run voyzu:build-api-reference",
    "voyzu:run-script": "node .run/voyzu/lib/runtime-tools/run-npm.mjs --prefix .run/voyzu run voyzu:run-script --"
  },
  "voyzu": {
    "mode": "production"
  }
}

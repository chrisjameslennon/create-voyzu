{
  "name": "{{PROJECT_NAME}}",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "voyzu:dev": "npm --prefix .run/voyzu run dev",
    "voyzu:build": "npm --prefix .run/voyzu run build",
    "prestart": "npm run voyzu:build",
    "start": "npm --prefix .run/voyzu run start",
    "voyzu:start": "npm start",
    "voyzu:add-repo": "npm --prefix .run/voyzu run voyzu:add-repo --",
    "voyzu:install": "npm --prefix .run/voyzu run voyzu:install --",
    "voyzu:refresh": "npm --prefix .run/voyzu run voyzu:refresh",
    "voyzu:refresh-repos": "npm --prefix .run/voyzu run voyzu:refresh-repos",
    "voyzu:refresh-repo": "npm --prefix .run/voyzu run voyzu:refresh-repo --",
    "voyzu:initialize": "npm --prefix .run/voyzu run voyzu:initialize",
    "voyzu:install-package": "npm --prefix .run/voyzu run voyzu:install-package --",
    "voyzu:compose": "npm --prefix .run/voyzu run voyzu:compose",
    "voyzu:run-script": "npm --prefix .run/voyzu run voyzu:run-script --"
  }
}

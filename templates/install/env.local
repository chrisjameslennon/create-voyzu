# Replace CHANGE_ME with the local PostgreSQL password.
VOYZU_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/voyzu

# Generated uniquely for this installation. Keep this value secret.
VOYZU_AUTH_SECRET={{VOYZU_AUTH_SECRET}}

# Optional when using the exchangerate-api-open provider.
VOYZU_CAPABILITY_FX_RATE_EXCHANGERATE_API_KEY=
